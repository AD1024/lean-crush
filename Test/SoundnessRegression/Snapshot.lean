import Crush

/-!
Capture the declaration boundary before elaborating hints and retain it throughout
reconstruction and Alethe replay. Unchecked auxiliaries generated by a hint must be
validated as new declarations; correctly generated auxiliaries remain usable.
-/

open Lean Meta Elab Term

namespace SoundnessSnapshot

elab "forged_false_hint" : term => do
  let name ← mkAuxDeclName `forgedFalse
  withOptions (fun options => options.setBool `debug.skipKernelTC true) do
    addDecl <| .thmDecl {
      name
      levelParams := []
      type := mkConst ``False
      value := mkConst ``True.intro }
  return mkConst name

elab "checked_true_hint" : term => do
  let name ← mkAuxDeclName `checkedTrue
  addDecl <| .thmDecl {
    name
    levelParams := []
    type := mkConst ``True
    value := mkConst ``True.intro }
  return mkConst name

set_option crush.trust "reconstruct"

/-- error: crush: solver reported `unsat`, but reconstruction failed -/
#guard_msgs(error, substring := true) in
theorem rejectsUncheckedHint : False := by
  crush [forged_false_hint]

-- Forced Alethe mode bypasses the selected-fact shortcut and pre-SMT strategies.
set_option crush.backend "cvc5" in
set_option crush.reconstruct "alethe" in
/-- error: crush: Alethe replay failed with kernel-reject -/
#guard_msgs(error, substring := true) in
theorem rejectsUncheckedHintDuringReplay : False := by
  crush [forged_false_hint]

theorem acceptsCheckedHint : True := by
  crush [checked_true_hint]

end SoundnessSnapshot
